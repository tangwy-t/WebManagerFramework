# ============================================================
# docker compose 环境变量覆盖示例
# 复制为同目录 .env 后修改（.env 会被 docker compose 自动读取）
# ============================================================

# MySQL 连接（宿主机现存实例）
DATABASE_HOST=host.docker.internal
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_DBNAME=web_manager_framework

# Redis 连接（宿主机现存实例，无密码留空即可）
REDIS_ADDR=host.docker.internal:6379

# 端口映射
SERVER_PORT=8088
WEB_PORT=80

# 镜像源覆盖（默认 goproxy.cn / registry.npmmirror.com）
# GOPROXY=https://goproxy.cn,direct
# NPM_REGISTRY=https://registry.npmmirror.com